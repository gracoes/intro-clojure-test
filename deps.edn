{:paths ["src" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases {:compile {:jvm-opts ["-Dclojure.compile.path=target/classes"]
                     :main-opts ["-e" "(do (.mkdirs (java.io.File. \"target/classes\")) (compile 'fitness.safety.UnsafeResistanceException))"]}
           :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}
                               cider/cider-nrepl {:mvn/version "0.58.0"}}
                  :main-opts ["-m" "nrepl.cmdline"
                              "--middleware" "[cider.nrepl/cider-middleware]"]}
           :test {:extra-paths ["test"]}}}
